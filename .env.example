# Multi-chain configuration
# Base Chain (Chain ID: 8453)
BASE_BUNDLER_URL=https://api.candide.dev/bundler/v3/base/3a0141406d58bd82a2d0a471e8529208
BASE_PAYMASTER_RPC=https://api.candide.dev/paymaster/v3/base/3a0141406d58bd82a2d0a471e8529208

# Polygon Chain (Chain ID: 137)
POLYGON_BUNDLER_URL=https://api.candide.dev/bundler/v3/polygon/3a0141406d58bd82a2d0a471e8529208
POLYGON_PAYMASTER_RPC=https://api.candide.dev/paymaster/v3/polygon/3a0141406d58bd82a2d0a471e8529208

# RPC URLs (optional - can be passed in request body)
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com

# Rate limiting and circuit breaker settings
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Development settings
NODE_ENV=development
PORT=3000

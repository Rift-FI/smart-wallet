# =============================================================================
# smart-wallet — environment reference
# =============================================================================
# Copy this file to `.env` and fill in real values. Never paste your real `.env`
# into chat / PRs / Slack — keys here in `.env.example` MUST be placeholders.
#
# Sections:
#   1. Server config
#   2. Bundler + paymaster RPCs (per chain)
#   3. Default chain RPC URLs
#   4. WalletConnect
#   5. Celo custom paymaster
#   6. Reference: deployed contracts, addresses, gas accounting math
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Server config
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3500
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30000


# -----------------------------------------------------------------------------
# 2. Bundler + Paymaster RPCs (Pimlico)
# -----------------------------------------------------------------------------
# Pimlico exposes both bundler and ERC-20 paymaster endpoints per chain.
# For Celo, ONLY the bundler URL is actually used — the paymaster role is
# served by our own Erc20Paymaster contract (see section 5).

ETHEREUM_BUNDLER_URL="https://api.pimlico.io/v1/ethereum/rpc?apikey=YOUR_PIMLICO_KEY"
ETHEREUM_PAYMASTER_RPC="https://api.pimlico.io/v2/ethereum/rpc?apikey=YOUR_PIMLICO_KEY"

BASE_BUNDLER_URL="https://api.pimlico.io/v1/base/rpc?apikey=YOUR_PIMLICO_KEY"
BASE_PAYMASTER_RPC="https://api.pimlico.io/v2/base/rpc?apikey=YOUR_PIMLICO_KEY"

POLYGON_BUNDLER_URL="https://api.pimlico.io/v1/polygon/rpc?apikey=YOUR_PIMLICO_KEY"
POLYGON_PAYMASTER_RPC="https://api.pimlico.io/v2/polygon/rpc?apikey=YOUR_PIMLICO_KEY"

ARBITRUM_BUNDLER_URL="https://api.pimlico.io/v1/arbitrum/rpc?apikey=YOUR_PIMLICO_KEY"
ARBITRUM_PAYMASTER_RPC="https://api.pimlico.io/v2/arbitrum/rpc?apikey=YOUR_PIMLICO_KEY"

AVALANCHE_BUNDLER_URL="https://api.pimlico.io/v1/avalanche/rpc?apikey=YOUR_PIMLICO_KEY"
AVALANCHE_PAYMASTER_RPC="https://api.pimlico.io/v2/avalanche/rpc?apikey=YOUR_PIMLICO_KEY"

BSC_BUNDLER_URL="https://api.pimlico.io/v1/binance/rpc?apikey=YOUR_PIMLICO_KEY"
BSC_PAYMASTER_RPC="https://api.pimlico.io/v2/binance/rpc?apikey=YOUR_PIMLICO_KEY"

BERACHAIN_BUNDLER_URL="https://api.pimlico.io/v1/berachain/rpc?apikey=YOUR_PIMLICO_KEY"
BERACHAIN_PAYMASTER_RPC="https://api.pimlico.io/v2/berachain/rpc?apikey=YOUR_PIMLICO_KEY"

# Celo — bundler used; paymaster RPC unused (we use our own contract instead).
CELO_BUNDLER_URL="https://api.pimlico.io/v1/celo/rpc?apikey=YOUR_PIMLICO_KEY"
CELO_PAYMASTER_RPC="https://api.pimlico.io/v2/celo/rpc?apikey=YOUR_PIMLICO_KEY"


# -----------------------------------------------------------------------------
# 3. Default chain RPC URLs (used when request body doesn't override)
# -----------------------------------------------------------------------------
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
BSC_RPC_URL=https://bsc-dataseed.binance.org
BERACHAIN_RPC_URL=https://rpc.berachain.com/
CELO_RPC_URL=https://forno.celo.org


# -----------------------------------------------------------------------------
# 4. WalletConnect
# -----------------------------------------------------------------------------
WALLETCONNECT_PROJECT_ID=YOUR_WC_PROJECT_ID


# -----------------------------------------------------------------------------
# 5. Celo custom paymaster (Erc20Paymaster.sol)
# -----------------------------------------------------------------------------
# Architecture: own ERC-20 paymaster contract + Pimlico bundler.
# Price source: CELO/USD via Coingecko, signed PER UserOp into paymasterData.
# No on-chain price config — every UserOp carries a fresh price.
#
#   Deployed paymaster:    0xb11b9304db584045f35825f08d5f6da779c80da1  (chain 42220)
#   Deployer / owner:      0x7ab104fe43968cbf2ca4b571d0c64c9d8eefe67c
#   Verifying signer:      0x7ab104fe43968cbf2ca4b571d0c64c9d8eefe67c  (same EOA as owner — split later)
#   Supported tokens:
#     USDC  0xcebA9300f2b948710d2653dD7B07f33A8B32118C  (6 dec)
#     USDT  0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e  (6 dec)
CELO_PAYMASTER_ADDRESS=0xCELO_PAYMASTER_CONTRACT
CELO_PAYMASTER_SIGNER_KEY=0xCELO_VERIFYING_SIGNER_PRIVATE_KEY  # signs every UserOp's paymasterData
CELO_PAYMASTER_OWNER_KEY=0xCELO_OWNER_PRIVATE_KEY              # used by scripts/configure-celo-paymaster.ts
CELO_PRICE_USD=0.5         # fallback if Coingecko fails
CELO_PRICE_MARKUP=11000    # 10000 = 100%, default 11000 = 110%


# -----------------------------------------------------------------------------
# 6. Reference: addresses, accounting math, ops loop
# -----------------------------------------------------------------------------
# Canonical EntryPoint v0.7 (same address on every chain):
#   0x0000000071727De22E5E9d8BAf0edAc6f37da032
#
# -----------------------------------------------------------------------------
# How USDT/USDC gets deducted from the user's smart account on Celo
# -----------------------------------------------------------------------------
#
# Per-UserOp flow:
#
#   1. Backend (this server) prepares the UserOp.
#   2. Backend's Celo paymaster middleware:
#      - fetches CELO/USD from Coingecko (cached 5 min)
#      - computes pricePerNative = round(celoPriceUsd * 10^tokenDecimals)
#        e.g. CELO=$0.32, USDC 6dec → pricePerNative = 320_000
#      - signs (UserOp fields + token + validUntil + validAfter + pricePerNative)
#        with CELO_PAYMASTER_SIGNER_KEY
#      - encodes paymasterData = token(20) + validUntil(6) + validAfter(6)
#                              + pricePerNative(32) + signature(65)  → 129 bytes
#   3. Pimlico bundler submits the UserOp to EntryPoint on Celo.
#   4. EntryPoint calls paymaster.validatePaymasterUserOp:
#      - parses paymasterData
#      - checks token in supportedTokens map
#      - verifies signature against on-chain verifyingSigner
#      - returns context = (sender, token, pricePerNative)
#   5. UserOp's callData runs — first call must be `approve(paymaster, max)`,
#      then the actual transfer.
#   6. EntryPoint calls paymaster.postOp:
#      - computes:
#          actualTokenCost = (actualGasCost * pricePerNative * priceMarkup)
#                          / (1e18 * 10000)
#      - pulls that many tokens from the sender (the smart account)
#        via IERC20.safeTransferFrom
#
# Worked example:
#   actualGasCost  = 0.001 CELO       = 1e15 wei
#   CELO/USD       = $0.32
#   pricePerNative = 320_000          (6-dec token)
#   priceMarkup    = 11000            (110%)
#
#   cost = (1e15 * 320_000 * 11000) / (1e18 * 10000)
#        = 352
#        = 0.000352 USDC
#
#   Verification: $0.32/CELO * 0.001 CELO * 1.10 = $0.000352  ✓
#
# Why this is safe:
#   - The PRICE the user gets charged is the price at the moment we sign
#     (Coingecko cached up to 5 min). No on-chain config to maintain.
#   - The 10% markup absorbs gas spikes and slight price drift between sign
#     and execute.
#   - validUntil = sign-time + 10 min. After that the userOp expires.
#
# -----------------------------------------------------------------------------
# Top-up loop ("never fail" recipe)
# -----------------------------------------------------------------------------
# What drains:
#   entryPoint.balanceOf(CELO_PAYMASTER_ADDRESS)  ← native CELO ledger inside
#                                                   the EntryPoint contract.
#                                                   Drains every UserOp.
#
# What grows:
#   IERC20(USDT|USDC).balanceOf(CELO_PAYMASTER_ADDRESS)  ← user payments
#                                                          accumulate here.
#
# To top up the deposit:
#   From the owner EOA (or any EOA — depositTo is permissionless):
#     cast send 0x0000000071727De22E5E9d8BAf0edAc6f37da032 \
#       "depositTo(address)" $CELO_PAYMASTER_ADDRESS \
#       --value 5ether \
#       --rpc-url https://forno.celo.org \
#       --private-key $CELO_PAYMASTER_OWNER_KEY
#
# To withdraw revenue (token):
#     cast send $CELO_PAYMASTER_ADDRESS \
#       "withdrawTokens(address,address,uint256)" $TOKEN $TO $AMOUNT \
#       --rpc-url https://forno.celo.org \
#       --private-key $CELO_PAYMASTER_OWNER_KEY
#
# To check current deposit:
#     cast call 0x0000000071727De22E5E9d8BAf0edAc6f37da032 \
#       'balanceOf(address)(uint256)' $CELO_PAYMASTER_ADDRESS \
#       --rpc-url https://forno.celo.org
#
# Funding addresses (which one to send CELO to):
#   - Send Binance/exchange CELO → CELO_PAYMASTER_OWNER_KEY's EOA
#     (i.e. 0x7ab104fe43968cbf2ca4b571d0c64c9d8eefe67c).
#   - DO NOT send CELO directly to the paymaster contract address — that lands
#     in `address(paymaster).balance` which the EntryPoint never reads.
#   - Always use the **Celo network** for the withdrawal (not BSC, not Eth).

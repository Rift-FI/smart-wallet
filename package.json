{
  "name": "smart-wallets-server",
  "version": "1.0.0",
  "description": "Minimal TypeScript Express server with strong types and security",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "docs": "npx serve riftgate -l 3001"
  },
  "keywords": [
    "typescript",
    "express",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@walletconnect/core": "^2.23.7",
    "@walletconnect/web3wallet": "^1.16.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "5.7.2",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "permissionless": "^0.2.57",
    "tslib": "^2.8.1",
    "viem": "^2.37.6"
  },
  "devDependencies": {
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.4.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
